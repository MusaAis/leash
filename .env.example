# Copy to .env and fill in. Never commit .env. One line per key; a repeated key is an error.
LEASH_PREFIX=myleash
# LEASH_OWNER=   # optional: owner account if it is not <prefix>-owner.<network> (for example a 64-character implicit account)
NETWORK=testnet
NEAR_AI_API_KEY=
NEAR_AI_MODEL=zai-org/GLM-5.1-FP8
# Optional limits for live-model runs (defaults shown)
# NEAR_AI_MAX_TOKENS=4000
# LEASH_MAX_MODEL_CALLS=30
# LEASH_MAX_TOTAL_TOKENS=80000
# LEASH_MAX_INPUT_CHARS=2000
# LEASH_MAX_DAILY_CALLS=150
# LEASH_MAX_DAILY_TOKENS=200000
# LEASH_TEMPERATURE=0
# NEAR Intents (1Click), used by the guardian. Dry quotes spend nothing.
# LEASH_ROUTE_RECIPIENT=      # address of a wallet YOU control on the destination chain. Never commit it.
# LEASH_ROUTE_DEST_ASSET=     # asset id from `make intents-tokens`; default for the dry quote: USDC on Base
# LEASH_1CLICK_API_KEY=       # optional partner key (sent as X-API-Key); without it 1Click adds a fee
# LEASH_DRY_REFUND_TO=        # optional: an existing NEAR account for the dry quote, if the vault account does not exist yet
# LEASH_INTENT_GAS_TGAS=150    # prepaid gas for spend_intent, 120 to 300 (the 30 Tgas of spend is separate)
# LEASH_WNEAR=                 # default wrap.testnet / wrap.near; set only to rehearse on another token contract
# LEASH_GUARDIAN_LOG=         # default ~/.leash/guardian-log.jsonl (private, holds quote signatures)
